# Django Configuration
DJANGO_SECRET_KEY=django-insecure-resumeiq-super-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Max Upload Size in Megabytes (default: 5)
MAX_UPLOAD_SIZE_MB=5

# LLM Configuration
# Supported providers: 'gemini', 'openai', 'groq', or 'mock' (default: auto-detected from keys)
LLM_PROVIDER=auto

# Option A: Google Gemini API (Recommended)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Option B: OpenAI or OpenAI-Compatible API (e.g. Groq, OpenRouter, Ollama)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Note: If no API key is provided, ResumeIQ automatically uses its built-in
# intelligent offline analyzer so you can test all features immediately without setup!
